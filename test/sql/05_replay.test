# name: test/sql/05_replay.test
# description: full pipeline replayed offline against the frozen demo responses
# group: [semantic_profile]
#
# No API key and no network. Every judgment below came from a real jev-1.13.0 run
# against demo/messy.sql and was frozen into test/fixtures/shipments_cache.jsonl.
# Offline mode makes a cache miss a hard error, so this cannot silently pass on
# fabricated answers.

require semantic_profile

statement ok
SELECT sem_config('cache_path', 'test/fixtures/shipments_cache.jsonl');

statement ok
SELECT sem_config('offline', 'true');

statement ok
SELECT sem_reset_stats();

statement ok
