) AS t(id, order_ref, customer, email, address, city, region, postal_code, country,
       product_name, category, weight, qty, status, ordered_at, shipped_at, notes);

# Discovery reads the values, not the names: a VARCHAR column of "12 kg" and
# "26.4" is a physical measurement whose unit is mixed.
query II
SELECT semantic_type, unit_or_currency FROM sem_columns('shipments') WHERE column_name = 'weight';
----
physical_measurement	mixed

# PII is found in free text, in a column named nothing like it.
query I
SELECT sensitive_personal_data > 0.9 FROM sem_columns('shipments') WHERE column_name = 'notes';
----
true

# The adaptive step picks the check that matches the planted defect.
query I
SELECT selected FROM sem_probes('shipments')
WHERE column_name = 'address' AND probe_id = 'operational_note_in_data_field';
----
true

# A probe whose premise is the semantic type is skipped when discovery was unsure.
# product_name was classified sku_or_product_code at ~0.51 confidence.
query I
SELECT count(*) FROM sem_probes('shipments')
WHERE column_name = 'product_name' AND probe_id = 'type_mismatch';
----
0

# Cross-column contradictions, which no column-at-a-time semantic_profile can reach.
query I
SELECT count(DISTINCT json_extract(row_json,'$.id')::INT)
FROM sem_findings('shipments', rows:=20) WHERE probe_id = 'geo_inconsistent';
----
2

# Rows 7 and 15 are shipped with no ship date; row 19 is delivered with a
# 9999-12-31 sentinel standing in for the real one. All three are real.
query I
SELECT count(DISTINCT json_extract(row_json,'$.id')::INT)
FROM sem_findings('shipments', rows:=20) WHERE probe_id = 'status_timeline_inconsistent';
----
3

# Calibration: bare numbers separate cleanly from values that state their unit,
# but land in the needs_review band rather than being asserted as defects.
query II
SELECT round(max(probability) FILTER (value NOT LIKE '%kg%'), 2),
       round(max(probability) FILTER (value LIKE '%kg%'), 2)
FROM sem_values('shipments', rows:=20)
WHERE column_name = 'weight' AND probe_id = 'unit_ambiguous';
----
0.57	0.02

# Re-slicing a report is free: changing the threshold re-reads cached judgments.
query I
SELECT (SELECT count(*) FROM sem_report('shipments', threshold:=0.9, rows:=20))
     < (SELECT count(*) FROM sem_report('shipments', threshold:=0.5, rows:=20));
----
true

# The whole replay ran without a single request.
query I
SELECT json_extract(sem_stats(), '$.requests');
----
0
