# name: test/sql/04_failure_modes.test
# description: misconfiguration fails loudly; malformed questions fail per row
# group: [profiler]

require profiler

statement ok
SELECT profiler_config('cache_path', 'test/fixtures/no-such-cache.jsonl');

statement ok
SELECT profiler_config('offline', 'true');

# A cache miss in offline mode is a hard error, not a silent NULL. Tests that
# replay from a fixture depend on this: a miss must be impossible to overlook.
statement error
SELECT ts_noul('hello', 'is this urgent?');
----
offline mode

# Malformed questions are reported in-band, per row, without killing the query.
query I
SELECT json_extract_string(ts_ask('state', 'not json'), '$.error') LIKE '%not valid JSON%';
----
true

query I
SELECT json_extract_string(ts_ask('state', '[]'), '$.error') LIKE '%non-empty JSON object%';
----
true

# A NULL argument yields NULL and never becomes a request.
query I
SELECT ts_ask(NULL, '{"q":{"type":"noul","instructions":"x"}}') IS NULL;
----
true

query I
SELECT ts_ask('state', NULL) IS NULL;
----
true

# Restore the defaults: these settings are process-global and the runner may
# execute every .test file in one process, in an order we do not control.
statement ok
SELECT profiler_config('offline', 'false');

statement ok
SELECT profiler_config('cache_path', 'test/fixtures/shipments_cache.jsonl');
