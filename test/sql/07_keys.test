# name: test/sql/07_keys.test
# description: findings name rows by the table's own key, not their sample position
# group: [semantic_profile]
#
# Replays the frozen demo responses offline, like 05_replay, but with `shipments`
# declared with a PRIMARY KEY. The key never enters a request, so the cache still
# hits; only the report layer changes.

require semantic_profile

statement ok
SELECT sem_config('cache_path', 'test/fixtures/shipments_cache.jsonl');

statement ok
SELECT sem_config('offline', 'true');

statement ok
SELECT sem_reset_stats();

statement ok
CREATE TABLE shipments (id INTEGER PRIMARY KEY, order_ref VARCHAR, customer VARCHAR, email VARCHAR,
    address VARCHAR, city VARCHAR, region VARCHAR, postal_code VARCHAR, country VARCHAR,
    product_name VARCHAR, category VARCHAR, weight VARCHAR, qty INTEGER, status VARCHAR,
    ordered_at VARCHAR, shipped_at VARCHAR, notes VARCHAR);

