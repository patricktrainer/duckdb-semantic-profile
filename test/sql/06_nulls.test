# name: test/sql/06_nulls.test
# description: a SQL NULL is not a sentinel -- regression, replayed offline
# group: [semantic_profile]
#
# Found by running the semantic_profile against a real warehouse. Columns that were
# 86-99% NULL came back flagged as sentinel_used_as_value at up to 100%, which
# is exactly backwards: NULL is absence expressed correctly, and that probe
# exists to find values that STAND IN for absence. It buried every real finding.
#
# The demo table has no NULLs anywhere, which is why the original suite missed it.

require semantic_profile

statement ok
SELECT sem_config('cache_path', 'test/fixtures/sparse_cache.jsonl');

statement ok
SELECT sem_config('offline', 'true');

statement ok
CREATE TABLE sparse AS SELECT * FROM (VALUES
 (1, 'ada@example.com',   NULL, 'active', 12),
 (2, NULL,                NULL, NULL,     NULL),
 (3, 'n/a',               NULL, NULL,     NULL),
 (4, NULL,                NULL, 'active', NULL),
 (5, 'grace@example.com', NULL, NULL,      7),
 (6, NULL,                NULL, NULL,     -1)
) AS t(id, email, note, status, retry_count);

# THE regression: no value probe is ever answered against a NULL.
query I
SELECT count(*) FROM sem_values('sparse', rows:=6)
WHERE scope = 'value' AND value IS NULL;
----
0

# `note` is NULL in every row, so it contributes no value judgments at all --
# and, because questions are pruned per row, costs no tokens either.
query I
SELECT count(*) FROM sem_values('sparse', rows:=6) WHERE column_name = 'note';
----
0

# The other half of the distinction: values that stand in for absence are still
# caught. 'n/a' in an email column...
query I
SELECT max(probability) > 0.9 FROM sem_values('sparse', rows:=6)
WHERE column_name = 'email' AND probe_id = 'sentinel_used_as_value' AND value = 'n/a';
----
true

# ...and -1 in a count column.
query I
SELECT max(probability) > 0.7 FROM sem_values('sparse', rows:=6)
WHERE column_name = 'retry_count' AND probe_id = 'sentinel_used_as_value' AND value = '-1';
----
true

# Rows are still judged as wholes even when most of their fields are NULL.
query I
SELECT count(*) > 0 FROM sem_values('sparse', rows:=6) WHERE scope = 'row';
----
true

# Replayed entirely from the fixture.
query I
SELECT json_extract(sem_stats(), '$.requests');
----
0

statement ok
SELECT sem_config('offline', 'false');

statement ok
SELECT sem_config('cache_path', 'test/fixtures/shipments_cache.jsonl');
